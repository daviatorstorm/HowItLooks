<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HowItLooks.MainPage"
             xmlns:strings="clr-namespace:HowItLooks.Resources.Languages"
             xmlns:extension="clr-namespace:HowItLooks.Extension"
             Title="{extension:Translate Key=Main}">
    <!--AeroMaticsStencil--> <!--BravoSCT-->
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
            Padding="10,0"
            Spacing="25">
                <Border x:Name="RoundCounterBorder"
                    Style="{StaticResource RoundCounterBorderStyle}"
                    IsVisible="False">
                    <Label x:Name="RoundCounterLabel"
                       Text="{Binding RoundDisplayText}"
                       Style="{StaticResource RoundCounterLabelStyle}"/>
                </Border>

                <CollectionView ItemsSource="{Binding Enemies}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3,0,3">
                                <Border.Stroke>
                                    <SolidColorBrush Color="Transparent" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Stroke" Value="MediumPurple" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Setter Property="Padding" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Stroke" Value="Transparent" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                        <Setter Property="Padding" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding CreatureType}" Value="Player">
                                        <Setter Property="BackgroundColor">
                                            <Setter.Value>
                                                <AppThemeBinding Light="{StaticResource PlayerBaseLight}"
                                                               Dark="{StaticResource PlayerBaseDark}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding CreatureType}" Value="Monster">
                                        <Setter Property="BackgroundColor">
                                            <Setter.Value>
                                                <AppThemeBinding Light="{StaticResource MonsterBaseLight}"
                                                               Dark="{StaticResource MonsterBaseDark}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding CreatureType}" Value="NPC">
                                        <Setter Property="BackgroundColor">
                                            <Setter.Value>
                                                <AppThemeBinding Light="{StaticResource NPCBaseLight}"
                                                               Dark="{StaticResource NPCBaseDark}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Label 
                                        Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                        Text="{Binding Name}" FontSize="22" 
                                        TextColor="{AppThemeBinding Light={StaticResource Black},Dark={StaticResource White}}"
                                        Margin="5"
                                        BindingContext="{Binding}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="NameLabel_Clicked"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Image Grid.Row="1" >
                                        <Image.Source>
                                            <AppThemeBinding Light="shield_dark.png" Dark="shield.png" />
                                        </Image.Source>
                                    </Image>    
                                    <Label 
                                        Grid.Row="1"  
                                        Text="{Binding ArmorClass}" FontSize="19" 
                                        TextColor="{AppThemeBinding Light={StaticResource Black},Dark={StaticResource White}}"
                                        VerticalTextAlignment="Center"
                                        HorizontalTextAlignment="Center"
                                        BindingContext="{Binding}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="ArmorClassLabel_Clicked"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <!--<Image  Grid.Row="0" Grid.Column="4" 
                                            Source="papyrus"/>-->
                                    <Label 
                                        Grid.Row="0" Grid.Column="4"
                                        Text="{Binding CreatureType}" 
                                        FontSize="17" 
                                        TextColor="{AppThemeBinding Light={StaticResource Black},Dark={StaticResource White}}"
                                        VerticalTextAlignment="Center"
                                        HorizontalTextAlignment="Center"
                                        Padding="0,0,0,0"
                                        BindingContext="{Binding}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="CreatureTypeLabel_Clicked" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Image MaximumHeightRequest="35"
                                           Grid.Row="0" Grid.Column="0">
                                           <Image.Source>
                                                <AppThemeBinding Light="hexagon_dark.png" Dark="hexagon_light.png" />
                                           </Image.Source>
                                    </Image>
                                    <Label 
                                        Grid.Row="0" Grid.Column="0"
                                        Text="{Binding Initiative}" FontSize="19" 
                                        TextColor="{AppThemeBinding Light={StaticResource Black},Dark={StaticResource White}}"
                                        VerticalTextAlignment="Center"
                                        HorizontalTextAlignment="Center"
                                        BindingContext="{Binding}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="InitiativeLabel_Clicked"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Button 
                                        Grid.Row="1" Grid.Column="1"
                                        x:Name="IncreaseHP"
                                        ImageSource="keyboard_double_arrow_up.png"
                                        Clicked="IncreaseHP_Clicked" BindingContext="{Binding}"
                                        BackgroundColor="Green"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource EnemyBtn}" />
                                    <Label 
                                        Grid.Row="1" Grid.Column="2"
                                        TextColor="{AppThemeBinding Light={StaticResource Black},Dark={StaticResource White}}"
                                        VerticalTextAlignment="Center"
                                        HorizontalTextAlignment="Center"
                                        BindingContext="{Binding}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="HPLabel_Clicked"/>
                                        </Label.GestureRecognizers>
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding HitPointsLabel, Mode=TwoWay}" FontSize="20" FontFamily="AeroMaticsStencil" />
                                                <Span Text="   " FontFamily="FluentSystemIcons-Filled" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Button 
                                        Grid.Row="1" Grid.Column="3"
                                        x:Name="DecreaseHP"
                                        ImageSource="keyboard_double_arrow_down.png"
                                        Clicked="DecreaseHP_Clicked" BindingContext="{Binding}"
                                        HorizontalOptions="End"
                                        BackgroundColor="Red"
                                        Style="{StaticResource EnemyBtn}" />
                                    <Button 
                                        Grid.Row="1" Grid.Column="4"
                                        x:Name="RemoveEnemy"
                                        ImageSource="delete.png"
                                        BindingContext="{Binding}"
                                        HorizontalOptions="End"
                                        BackgroundColor="Red"
                                        Clicked="RemoveEnemy_Clicked"
                                        Style="{StaticResource EnemyBtn}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button 
                    x:Name="AddListItem"
                    Text="{extension:Translate Key=Add}"
                    Clicked="AddEnemyClicked"
                    Margin="0,0,0,10"/>
            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="Overlay"
                 BackgroundColor="#80000000"
                 IsVisible="False"
                 Grid.RowSpan="2" />
        <Frame x:Name="ActionLogDrawer"
               Grid.RowSpan="2"
               BackgroundColor="#222"
               BorderColor="#444"
               CornerRadius="0"
               HasShadow="True"
               IsVisible="False"
               WidthRequest="300"
               HorizontalOptions="End"
               TranslationX="300"
               Padding="10,20,10,10">
            <ScrollView >
                <VerticalStackLayout>
                    <Label Text="📜 Action Log"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10"/>
                    <VerticalStackLayout x:Name="ActionLogContainer"
                                         Spacing="15"
                                         Padding="0,0,0,20"/>
                    <Button Text="🧹 Clear"
                            Clicked="ClearLog_Clicked"
                            BackgroundColor="#333"
                            TextColor="White"
                            CornerRadius="10"
                            Margin="0,10,0,0"
                            FontAttributes="Bold"
                            Padding="10,5"/>
                </VerticalStackLayout>
            </ScrollView>
        </Frame>
        <Button
                 x:Name="ActionLogButton"
                 Text="Log"
                 Clicked="ActionLogButton_Clicked"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 Margin="0,0,0,10"
                 Style="{StaticResource NavButtonStyle}"/>

        <Grid Grid.Row="1"
              BackgroundColor="#000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="{extension:Translate Key=Previous}"
                    Clicked="PreviousEnemy_Clicked"
                    Style="{StaticResource NavButtonStyle}"/>
            <Image  Grid.Column="0"
                    Source="arrow_back_ios.png"
                    Margin="10,0"
                    HorizontalOptions="Start" />
            <Button Grid.Column="1"
                    x:Name="StartEndButton"
                    Text="{Binding StartEndButtonText}"
                    Clicked="StartEndButton_Clicked"
                    Style="{StaticResource StartEndButtonStyle}"/>
            <Button Grid.Column="2"
                    Text="{extension:Translate Key=Next}"
                    Clicked="NextEnemy_Clicked"
                    Style="{StaticResource NavButtonStyle}"/>
            <Image  Grid.Column="2"
                    Source="arrow_forward_ios.png"
                    Margin="10,0"
                    HorizontalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>
