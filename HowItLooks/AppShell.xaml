<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HowItLooks.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HowItLooks"
    Shell.FlyoutBehavior="Flyout"
    xmlns:extension="clr-namespace:HowItLooks.Extension"
    xmlns:strings="clr-namespace:HowItLooks.Resources.Languages"
    Title="How it looks">

    <ShellContent Route="Campaigns" ContentTemplate="{DataTemplate local:Campaigns}" />
    <!--<ShellContent Route="MainPage" ContentTemplate="{DataTemplate local:MainPage}" />-->
    <ShellContent Route="Globals" ContentTemplate="{DataTemplate local:Globals}" />
    <ShellContent Route="Groups" ContentTemplate="{DataTemplate local:Groups}" />
    <!--<ShellContent Route="Groups/details" ContentTemplate="{DataTemplate local:GroupDetailsPage}" />-->
    <!--<ShellContent Route="Groups" ContentTemplate="{DataTemplate local:Groups}" >
        <ShellContent Route="details" ContentTemplate="{DataTemplate local:GroupDetailsPage}" />
    </ShellContent>-->
    

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="10" Spacing="20">
            <Grid Padding="10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCampaignsTapped" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="MainIcon"
                       Source="campaign.png"
                       Style="{StaticResource FlyoutMenuIconStyle}"/>
                <Label Text="{extension:Translate Key=Battle}"
                       Grid.Column="1"
                       Style="{StaticResource FlyoutMenuLabelStyle}" />
            </Grid>

            <Grid Padding="10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGlobalsTapped" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="GlobalsIcon"
                       Source="earth.png"
                       Style="{StaticResource FlyoutMenuIconStyle}"/>
                <Label Text="{extension:Translate Key=Global}"
                       Grid.Column="1"
                       Style="{StaticResource FlyoutMenuLabelStyle}" />
            </Grid>
            <Grid Padding="10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGroupsTapped" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="GroupsIcon"
                       Source="groups_light.png"
                       Style="{StaticResource FlyoutMenuIconStyle}"/>
                <Label Text="{extension:Translate Key=Groups}"
                       Grid.Column="1"
                       Style="{StaticResource FlyoutMenuLabelStyle}" />
            </Grid>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Grid Padding="10"
              BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Picker
                x:Name="LanguagePicker"
                Margin="0,0,170,0"
                Grid.Column="0"
                WidthRequest="90"
                SelectedIndexChanged="OnLanguagePickerChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Українська</x:String>
                        <x:String>English</x:String>
                    </x:Array>
                </Picker.ItemsSource>

            </Picker>
            <ImageButton
                x:Name="ThemeToggleButton"
                Grid.Column="1"
                Style="{StaticResource ThemeToggleButtonStyle}"
                Clicked="OnThemeIconClicked" />
        </Grid>
    </Shell.FlyoutFooter>
</Shell>
